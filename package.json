{
  "name": "studio-screen",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:dev": "npm run native:build && concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop:pack": "npm run build && npm run native:build && electron-builder --win portable",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:desktop": "node tests/desktop-capture.mjs",
    "native:build": "cargo build --release --manifest-path native/studio-capture/Cargo.toml",
    "native:check": "node scripts/native-check.mjs"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.56.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "app.studioscreen.desktop",
    "productName": "Studio Screen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "native/studio-capture/target/release/studio-capture.exe",
        "to": "studio-capture.exe"
      }
    ]
  },
  "description": "Local-first screen recording and editing with internal PC audio.",
  "author": "Studio Screen"
}
